# Copy to .env for local development. .env is git-ignored.

# Google accounts that skip invites and get admin rights, comma-separated.
OWNER_EMAILS=

# Local emulators (`pnpm emulators`). Remove these four lines to run against production.
FIREBASE_PROJECT_ID=demo-chat
FIREBASE_DATABASE_URL=https://demo-chat-default-rtdb.firebaseio.com
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099
FIREBASE_DATABASE_EMULATOR_HOST=127.0.0.1:9000

# The bot: mock (default, canned replies), openrouter, anthropic or openai. CHAT_MODEL defaults
# to anthropic/claude-haiku-5.5 on OpenRouter and claude-sonnet-5-5 on Anthropic.
# CHAT_BACKEND=mock
# MOCK_DELAY_MS=45
# CHAT_MODEL=
# OPENROUTER_API_KEY=
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# A chat stops at whichever comes first: its budget in dollars, or its size in tokens (the bot
# sees the whole chat). The mock costs $0.01 an answer and counts a character as a token, so
# CHAT_BUDGET_USD=0.03 runs a chat out after three answers.
# CHAT_BUDGET_USD=1
# CHAT_CONTEXT_TOKENS=200000

# The knowledge base. Locally the bot reads a folder, kb/ by default; set KB_BUCKET=flopbut-kb
# (after `gcloud auth application-default login`) to read the bucket as production does.
# KB_DIR=kb
# KB_BUCKET=

# Asking Flop in Telegram (server/flop.ts): the bot's token and Flop's own account id. Locally
# set TELEGRAM_MODE=polling: the server takes the bot's webhook off while it runs, reads the
# answers itself, and gives the webhook back to production on exit, which needs the production
# TELEGRAM_WEBHOOK_SECRET. Without the token or the id, the bot never asks.
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_OWNER_ID=
# TELEGRAM_WEBHOOK_SECRET=
# TELEGRAM_MODE=polling

# The client uses the emulators in dev unless this is false.
# VITE_FIREBASE_EMULATORS=false

{
  "name": "chat.flopbut.pl",
  "version": "0.1.0",
  "description": "Private invite-only chat of Flop Butylkin - chat.flopbut.pl",
  "type": "module",
  "private": true,
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev:server": "tsx watch --env-file-if-exists=.env server/index.ts",
    "dev:web": "vite",
    "emulators": "scripts/firebase.sh emulators:start --only auth,database --project demo-chat",
    "build": "vite build && tsc -p tsconfig.server.json",
    "start": "node dist/server/index.js",
    "test": "scripts/firebase.sh emulators:exec --config firebase.test.json --only auth,database --project demo-chat \"vitest run\"",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "lint": "biome check .",
    "format": "biome check --write .",
    "verify": "pnpm lint && pnpm check && pnpm test && pnpm build"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "4.0.96",
    "@ai-sdk/openai": "4.0.108",
    "@hono/node-server": "^2.1.6",
    "@openrouter/ai-sdk-provider": "3.1.0",
    "ai": "7.0.162",
    "firebase-admin": "^14.5.0",
    "hono": "^4.13.16",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.4",
    "@firebase/rules-unit-testing": "^6.0.0",
    "@fontsource-variable/geologica": "^5.3.0",
    "@fontsource/golos-text": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "firebase": "^13.2.0",
    "firebase-tools": "^15.34.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "re2"
    ]
  }
}
